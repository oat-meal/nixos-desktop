# Network secrets — NOT tracked in git (secrets/ is gitignored)
#
# Setup:
#   1. Unlock the repo:  git-crypt unlock
#   2. Edit secrets/network.nix with real values
#   3. The real file is encrypted in git via git-crypt
#
# On a new host, unlock with:  git-crypt unlock /path/to/git-crypt-key
# Or copy the key from an unlocked host:  git-crypt export-key /tmp/git-crypt-key
#
# To get values:
#   LAN IPs:        ip -4 addr show | grep inet
#   WireGuard key:  wg genkey | tee /etc/wireguard/private.key | wg pubkey
#   Syncthing ID:   syncthing cli show system | grep myID
#   SSH pubkey:     cat ~/.ssh/id_ed25519.pub
{
  # Primary username
  user = "REPLACE";

  # LAN subnet
  lanSubnet = "192.168.x.0/24";

  # Per-host LAN IPs
  lanIPs = {
    workstation-nixos = "192.168.x.x";
    server-nixos = "192.168.x.x";
    laptop-nixos = "192.168.x.x";
  };

  # WireGuard mesh
  wireguard = {
    port = 51821;
    meshSubnet = "10.100.0.0/24";
    meshIPs = {
      workstation-nixos = "10.100.0.1";
      server-nixos = "10.100.0.2";
      laptop-nixos = "10.100.0.3";
    };
    publicKeys = {
      workstation-nixos = "REPLACE";
      server-nixos = "REPLACE";
      laptop-nixos = "REPLACE";
    };
  };

  # Syncthing device IDs (get with: syncthing cli show system | grep myID)
  syncthing = {
    workstation-nixos = "REPLACE";
    laptop-nixos = "REPLACE";
    server-nixos = "REPLACE";
  };

  # SSH public keys (get with: cat ~/.ssh/id_ed25519.pub)
  sshKeys = {
    workstation-nixos = "REPLACE";
    laptop-nixos = "REPLACE";
    server-nixos = "REPLACE";
  };
}
